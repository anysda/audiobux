{
  "openapi": "3.1.0",
  "info": {
    "title": "audiobux",
    "description": "A book file in, an audiobook with chapters and its text out. A request for another host, or a POST, PUT or DELETE without the service's own Origin, is refused with 403.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/books": {
      "post": {
        "summary": "Upload a book file",
        "description": "The file goes to `incoming/` under a fresh id and only there; it is gone again\nwhen it is too large, not a book, cut off, or the worker does not take it.",
        "operationId": "upload_api_books_post",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 1024,
              "description": "the file's name: the title, if the book has none",
              "default": "",
              "title": "Name"
            },
            "description": "the file's name: the title, if the book has none"
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submitted"
                }
              }
            }
          },
          "200": {
            "description": "the same file was there already: that book, `known` true"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "description": "the file itself, sent as it is; its format is told by its content",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      },
      "get": {
        "summary": "All books, the queue included",
        "operationId": "books_api_books_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "title": "Response Books Api Books Get"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
