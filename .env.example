# Настройки для docker compose. install.sh делает из этого файла .env, если его нет;
# после правки .env: docker compose up -d

# Каталог данных на машине: книги, очередь, модели (около 28 ГБ) и база.
# Относительный путь считается от каталога репозитория.
AUDIOBUX_DATA=./data

# Под этим пользователем и группой работают процессы в контейнерах, это владелец
# каталога данных. install.sh ставит их сам по владельцу каталога.
AUDIOBUX_UID=1000
AUDIOBUX_GID=1000

# Digest образов выпуска: install.sh берёт их из images.txt выпуска на GitHub,
# сверяет со скачанными образами и пишет сюда, контейнеры запускаются только с ними.
AUDIOBUX_WORKER_DIGEST=
AUDIOBUX_WEB_DIGEST=
AUDIOBUX_COVER_DIGEST=

# Тихие часы: в это время карта отдыхает, новая книга не начинается, начатая
# встаёт на паузу. Формат ЧЧ:ММ-ЧЧ:ММ, можно через полночь, например
# 00:00-08:00. Пусто - работать круглые сутки.
AUDIOBUX_QUIET_HOURS=

# Имена, по которым открывают интерфейс, кроме IP-адресов и localhost, через
# запятую. Например: books.home.lan
AUDIOBUX_HOSTS=

# Вход в интерфейс по паролю. off - без входа, если перед сервисом стоит
# обратный прокси со своим входом.
AUDIOBUX_LOGIN=on

# Адрес машины, на котором открыт интерфейс. 127.0.0.1 - только с этой машины,
# 0.0.0.0 - открыть в сеть.
AUDIOBUX_BIND=127.0.0.1

# Порт интерфейса на машине.
AUDIOBUX_PORT=8080

# Самый большой файл книги, который принимает интерфейс, в МБ.
AUDIOBUX_UPLOAD_MB=1024
